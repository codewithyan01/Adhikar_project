# =======================================================
# Adhikar (अधिकार) — Environment Configuration
# =======================================================

# LLM Provider Configuration ("gemini", "claude", "auto", or "mock")
LLM_PROVIDER=gemini

# Primary: Google Gemini API Key (Recommended - Free Tier available from Google AI Studio)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback: Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Bhashini AI API Key (Optional for live Government Bhashini Ulca API)
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
